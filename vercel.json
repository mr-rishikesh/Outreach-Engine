{
  "version": 2,
  "name": "outreach-engine",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/email/:path*", "destination": { "service": "backend" } },
    { "source": "/upload", "destination": { "service": "backend" } },
    { "source": "/debug/:path*", "destination": { "service": "backend" } },
    { "source": "/test", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
