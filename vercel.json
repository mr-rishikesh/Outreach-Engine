{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/email/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/upload",
      "dest": "backend/server.js"
    },
    {
      "src": "/debug/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/test",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
